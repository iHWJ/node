curl -L -o ~/Downloads/InstallAssistant.dmg "https://swcdn.apple.com/content/downloads/34/56/071-88632-A_9B8DD6F4-3D3B-4C1A-9E3F-1D3E4C5A6B7C/InstallAssistant.pkg"

curl -L -o ~/Downloads/installinstallmacos.py https://raw.githubusercontent.com/munki/macadmin-scripts/main/installinstallmacos.py
sudo python ~/Downloads/installinstallmacos.py --seedprogram

ls -lh ~/Downloads/InstallAssistant.dmg

hdiutil attach ~/Downloads/InstallAssistant.dmg

sudo installer -pkg /Volumes/Install\ Assistant/InstallAssistant.pkg -target /

hdiutil detach /Volumes/Install\ Assistant
rm ~/Downloads/InstallAssistant.dmg

sudo /Applications/Install\ macOS\ Monterey.app/Contents/Resources/startosinstall --agreetolicense

# 先同步网络时间
sudo sntp -sS time.apple.com

# 如果仍然报错，临时修改系统日期到 2022 年（Monterey 发布期间）
sudo date 010112002022

sudo python /Users/hongwenjun/Downloads/installinstallmacos.py --catalogurl https://swscan.apple.com/content/catalogs/others/index-10.10-10.9-10.8-10.7-10.6-10.5-10.4-10.3-10.2-10.1-10.0-10.merged-1.sucatalog

sudo python /Users/hongwenjun/Downloads/installinstallmacos.py --catalogurl https://swscan.apple.com/content/catalogs/others/index-10.15-10.14-10.13-10.12-10.11-10.10-10.9-10.8-10.7-10.6-10.5-10.4-10.3-10.2-10.1-10.0-10.merged-1.sucatalog

sudo pip install xattr


curl -k -L -o ~/Downloads/installinstallmacos.py https://raw.githubusercontent.com/munki/macadmin-scripts/main/installinstallmacos.py
PYTHONHTTPSVERIFY=0 sudo python ~/Downloads/installinstallmacos.py
sudo installer -pkg ~/Downloads/content/InstallAssistant.pkg -target /

curl -k -L -o ~/Downloads/OpenCore.zip https://github.com/acidanthera/OpenCorePkg/releases/download/0.9.9/OpenCore-0.9.9-RELEASE.zip
cd ~/Downloads
unzip OpenCore.zip -d OpenCore
cd OpenCore/Utilities/macrecovery
PYTHONHTTPSVERIFY=0 python macrecovery.py -b Mac-937CB26E8EEFAB25 -m 00000000000000000 download
sudo asr restore --source BaseSystem.dmg --target /Volumes/MyVolume --erase
